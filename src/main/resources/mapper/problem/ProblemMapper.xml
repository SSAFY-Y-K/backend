<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.passit.problem.mapper.ProblemMapper">

    <resultMap id="problemResultMap" type="com.ssafy.passit.problem.model.Problem">
        <id property="problemId" column="problem_id"/>
        <result property="problemSetId" column="problem_set_id"/>
        <result property="problemNumber" column="problem_number"/>
        <result property="problemType" column="problem_type"/>
        <result property="question" column="question"/>
        <result property="answerCorrectNumber" column="answer_correct_number"/>
        <result property="answerText" column="answer_text"/>
    </resultMap>

    <select id="findPublishedCodingProblemById"
            parameterType="long"
            resultMap="problemResultMap">
        SELECT
            problem_id,
            problem_set_id,
            problem_number,
            problem_type,
            question,
            answer_correct_number,
            answer_text
        FROM problems
        WHERE problem_id = #{problemId}
    </select>

</mapper>
