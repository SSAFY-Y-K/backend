<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.passit.problem.mapper.CodingProblemMapper">

    <resultMap id="codingProblemResultMap" type="com.ssafy.passit.problem.model.CodingProblem">
        <id property="problemId" column="problem_id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="inputDescription" column="input_description"/>
        <result property="outputDescription" column="output_description"/>
        <result property="constraintText" column="constraint_text"/>
        <result property="timeLimit" column="time_limit"/>
        <result property="memoryLimit" column="memory_limit"/>
        <result property="difficulty" column="difficulty"/>
        <result property="category" column="category"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="totalSubmissions" column="total_submissions"/>
        <result property="acCount" column="ac_count"/>
    </resultMap>

    <insert id="insertCodingProblem"
            parameterType="com.ssafy.passit.problem.model.CodingProblem"
            useGeneratedKeys="true"
            keyProperty="problemId">
        INSERT INTO coding_problems (
            title,
            description,
            input_description,
            output_description,
            constraint_text,
            time_limit,
            memory_limit,
            difficulty,
            category
        ) VALUES (
            #{title},
            #{description},
            #{inputDescription},
            #{outputDescription},
            #{constraintText},
            #{timeLimit},
            #{memoryLimit},
            #{difficulty},
            #{category}
        )
    </insert>

    <select id="findById"
            parameterType="long"
            resultMap="codingProblemResultMap">
        SELECT
            problem_id,
            title,
            description,
            input_description,
            output_description,
            constraint_text,
            time_limit,
            memory_limit,
            difficulty,
            category,
            created_at,
            updated_at
        FROM coding_problems
        WHERE problem_id = #{problemId}
    </select>


    <delete id="deleteCodingProblem" parameterType="long">
        DELETE FROM coding_problems WHERE problem_id = #{problemId}
    </delete>

    <select id="findAll" resultMap="codingProblemResultMap">
        SELECT cp.problem_id, cp.title, cp.difficulty, cp.category, cp.created_at, cp.updated_at,
               COALESCE(s.total, 0) AS total_submissions,
               COALESCE(s.ac_count, 0) AS ac_count
        FROM coding_problems cp
        LEFT JOIN (
            SELECT problem_id, COUNT(*) AS total, SUM(verdict = 'AC') AS ac_count
            FROM submissions
            GROUP BY problem_id
        ) s ON cp.problem_id = s.problem_id
        ORDER BY cp.created_at DESC
    </select>

</mapper>
