# Backend
AWS_REGION=ap-northeast-2
SERVER_PORT=8080
JAVA_OPTS="-Xms512m -Xmx1024m"
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_NICKNAME=admin
AI_SYSTEM_AUTHOR_ID=1

# RDS
RDS_HOST=passit-db.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
RDS_PORT=3306
RDS_DB_NAME=passit
RDS_USERNAME=passit
RDS_PASSWORD=change-me
DB_TIMEZONE=Asia/Seoul
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
JUDGE_PYTHON_IMAGE=python:3.11-slim
JUDGE_JAVA_IMAGE=eclipse-temurin:21
JUDGE_CPP_IMAGE=gcc:13

# AI server
OPENAI_API_KEY=change-me
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_COLLECTION=rag_chunks
RAG_TOP_K=12
RAG_QUESTION_COUNT=20
